# INFERRA local/staging environment template.
# Copy to .env for local Docker Compose overrides. Do not commit real secrets.

# Canonical feature-flag code defaults (reference only).
# These lines stay commented so copying this file does not silently replace the
# feature-rich local Compose profile. The executable source of truth is
# FEATURE_FLAG_SPECS in src/domain/state/feature_flags.py.
# INFERRA_USE_HYPERGRAPH=true
# INFERRA_LEGACY_ITERATE=true
# INFERRA_LAYERED_MEMORY=true
# INFERRA_ML_OPTIMIZED_DFS=false
# INFERRA_ASYNC_SYNC_ENABLED=false
# INFERRA_MODULAR_IMPORTS=false
# INFERRA_HYBRID_ORCHESTRATOR=false
# INFERRA_ASYNC_POST_REASONING=false
# INFERRA_GENERATE_POST_REASONING_TTL=false
# INFERRA_PROV_O_TRACE=false
# INFERRA_ENRICHED_API=false
# INFERRA_ONTOLOGY_ADVISORY_ENABLED=false
# INFERRA_ONTOLOGY_AUTO_ANSWER_ENABLED=false
# INFERRA_ONTOLOGY_AUTO_ANSWER_CONFIDENCE_THRESHOLD=0.85
# INFERRA_ONTOLOGY_REASONING_ENABLED=false
# INFERRA_ONTOLOGY_REASONING_CONFIDENCE_THRESHOLD=0.85
# INFERRA_ONTOLOGY_REASONING_MIN_HIERARCHY_DEPTH=1
# INFERRA_ONTOLOGY_REASONING_MAX_CLOSURE_DEPTH=10
# INFERRA_ONTOLOGY_QUESTION_STRATEGY_ENABLED=false
# INFERRA_REDIS_SESSION_STORE=false
# INFERRA_LLM_ENHANCEMENTS=false
# INFERRA_STRICT_PORT_CONTRACTS=true
# INFERRA_OBSERVABILITY_ENABLED=false
# INFERRA_AUTH_ENABLED=false
# INFERRA_ABDUCTION_ENABLED=false
# INFERRA_INDUCTION_PIPELINE=false
# INFERRA_REASONING_ROUTER=true
# INFERRA_CONFIDENCE_THRESHOLDS=true

# Feature-rich local/staging Compose overrides.
# API and worker receive this same profile. The two post-reasoning gates are
# enabled together so the workflow is never half-enabled.
INFERRA_REDIS_SESSION_STORE=true
INFERRA_ASYNC_SYNC_ENABLED=true
INFERRA_ASYNC_POST_REASONING=true
INFERRA_GENERATE_POST_REASONING_TTL=true
INFERRA_PROV_O_TRACE=true
INFERRA_ENRICHED_API=true
INFERRA_OBSERVABILITY_ENABLED=true
INFERRA_AUTH_ENABLED=true
INFERRA_ABDUCTION_ENABLED=true
INFERRA_INDUCTION_PIPELINE=true

INFERRA_API_KEY=replace-with-random-api-key
INFERRA_API_KEY_OWNER_ID=api-key
# Local demo/rehearsal API-key scopes. Keep browser-facing proxy keys read-only for
# LLM configuration; reserve llm:write for a direct authenticated operator/admin path.
INFERRA_API_KEY_SCOPES=read,llm:read,inference:read,inference:write
INFERRA_JWT_SECRET=replace-with-random-jwt-secret
INFERRA_CSRF_PROTECTION=false
INFERRA_CSRF_TOKEN=replace-with-random-csrf-token
INFERRA_CORS_ALLOWED_ORIGINS=http://localhost:5173
INFERRA_CORS_ALLOW_CREDENTIALS=false

POSTGRES_USER=inferra
POSTGRES_PASSWORD=replace-with-postgres-password
SQLALCHEMY_DATABASE_URI=postgresql://inferra:replace-with-postgres-password@postgres:5432/inferra
AEGIS_SQLALCHEMY_DATABASE_URI=postgresql://inferra:replace-with-postgres-password@postgres:5432/inferra_aegis
AEGIS_ALLOW_SHARED_DATABASE=false

FUSEKI_USER=admin
FUSEKI_PASSWORD=replace-with-fuseki-admin-password
FUSEKI_READ_USER=inferra_reader
FUSEKI_READ_PASSWORD=replace-with-distinct-fuseki-read-password

# Optional exported ontology overrides, shown matching the code defaults. API
# clients can override these per session with
# ontology_profile: off | advisory | auto_answer | reasoning | full_semantic_pilot,
# plus optional ontology_flags booleans for exact case-level combinations.
INFERRA_ONTOLOGY_ADVISORY_ENABLED=false
INFERRA_ONTOLOGY_AUTO_ANSWER_ENABLED=false
INFERRA_ONTOLOGY_REASONING_ENABLED=false
INFERRA_ONTOLOGY_QUESTION_STRATEGY_ENABLED=false
INFERRA_ONTOLOGY_AUTO_ANSWER_CONFIDENCE_THRESHOLD=0.85
INFERRA_ONTOLOGY_REASONING_CONFIDENCE_THRESHOLD=0.85
INFERRA_ONTOLOGY_REASONING_MIN_HIERARCHY_DEPTH=1
INFERRA_ONTOLOGY_REASONING_MAX_CLOSURE_DEPTH=10

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password

# Local Docker Redis is unauthenticated by default.
# Production rehearsal uses secrets/redis_password.txt via docker-compose.prod.yml.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Optional LLM feature override, shown matching the code default.
INFERRA_LLM_ENHANCEMENTS=false
INFERRA_ABDUCTION_ADAPTER=z3
INFERRA_LLM_ABDUCTION_MAX_HYPOTHESES=5

# Preferred deploy-time LLM catalog defaults. Runtime AXIOM/AEGIS selection uses
# the redacted /api/v1/llm/configuration endpoints and never returns raw keys.
INFERRA_LLM_PROVIDER=nvidia
INFERRA_LLM_MODEL=deepseek-ai/deepseek-v4-pro
MODALRESEARCH_API_KEY=
MODALRESEARCH_API_KEY_FILE=
NVIDIA_API_KEY=
NVIDIA_API_KEY_FILE=

# Required before storing editable AEGIS runtime provider keys. Keep previous
# keys during encryption-key rotation until all stored rows have been read or
# rewritten under the new primary key.
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AEGIS_LLM_API_KEY_ENCRYPTION_KEY=
AEGIS_LLM_API_KEY_ENCRYPTION_KEY_FILE=
AEGIS_LLM_API_KEY_ENCRYPTION_PREVIOUS_KEYS=
AEGIS_LLM_API_KEY_ENCRYPTION_PREVIOUS_KEYS_FILE=

# Optional comma-separated host/origin allowlist for private/internal LLM gateways.
# Public provider endpoints must use HTTPS; loopback, link-local, metadata, and
# RFC1918/private targets are rejected unless explicitly listed here.
INFERRA_LLM_ENDPOINT_ALLOWLIST=

# Generic custom OpenAI-compatible provider override.
INFERRA_LLM_BASE_URL=
INFERRA_LLM_API_KEY=
INFERRA_LLM_API_KEY_FILE=
INFERRA_LLM_API=openai-completions

# Legacy compatibility path.
ZAI_BASE_URL=
ZAI_API_KEY=
ZAI_API_KEY_FILE=
ZAI_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.1
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30

# Upload conversion guardrails.
DOCUMENT_CONVERSION_MAX_PDF_PAGES=100
DOCUMENT_CONVERSION_MAX_OUTPUT_CHARS=200000
DOCUMENT_CONVERSION_MAX_EXPANSION_RATIO=100.0
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=20.0
DOCUMENT_LLM_MAX_PROMPT_CHARS=50000
