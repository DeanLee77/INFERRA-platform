  "purpose": "Feature-tagged examples that authoring surfaces can discover and present to rule authors.",
  "examples": [
    {
      "id": "aegis_trigger_outcome_to_rule_set",
      "title": "Outcome-triggered downstream rule set",
      "description": "A governed trigger policy that starts a downstream rule set after a source rule-set outcome passes confidence, evidence, depth, and fact-source guardrails.",
      "audience": ["authoring_page", "rule_author", "workflow_reviewer"],
      "featureTags": ["trigger", "outcome-trigger", "rule-set-target", "receipt", "idempotency"],
      "authoringSurface": {
        "section": "Trigger policies",
        "searchTerms": ["trigger", "outcome", "rule set", "receipt", "idempotency"],
        "recommendedPrimaryPath": "docs/reference/examples/triggers/outcome_to_rule_set_policy.json"
      },
      "entrypoints": [
        {
          "label": "Source rule set",
          "path": "docs/reference/examples/triggers/aegis_trigger_source_assessment.txt",
          "mediaType": "text/plain"
        },
        {
          "label": "Target rule set",
          "path": "docs/reference/examples/triggers/aegis_trigger_target_eligibility.txt",
          "mediaType": "text/plain"
        },
        {
          "label": "Trigger policy",
          "path": "docs/reference/examples/triggers/outcome_to_rule_set_policy.json",
          "mediaType": "application/json"
        },
        {
          "label": "Outcome trigger request",
          "path": "docs/reference/examples/triggers/outcome_trigger_request.json",
          "mediaType": "application/json"
        }
      ],
      "runtime": {
        "policyEndpoint": "POST /api/v1/aegis/trigger-policies",
        "triggerEndpoint": "POST /api/v1/aegis/triggers/outcome",
        "expectedDecision": "executed",
        "expectedExecutionType": "rule_set"
      }
    },
